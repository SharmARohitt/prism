# ── PRISM Environment Configuration ──────────────────────────────
# Copy to .env and adjust values. Never commit .env.

# ── Database ──
# SQLite for local single-user prototype; use postgresql:// for multi-user
DATABASE_URL=sqlite:///./prism.db

# ── Git Mirror Storage ──
# Directory where persistent Git mirrors are stored
GIT_MIRROR_DIR=./data/git-mirrors

# ── LLM Provider ──
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
# Larger authorized self-hosted model can be configured here
# OLLAMA_MODEL=llama3.1:8b
    
# ── Server ──
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000

# ── Security ──
# Secret for webhook signature verification (generate with: python -c "import secrets; print(secrets.token_hex(32))")
WEBHOOK_SECRET=change-me-to-a-random-secret

# ── Integrations ──
# GitHub App credentials (optional for webhook mode)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=

# Personal Access Token for PR approval and merge via GitHub API.
# Required scopes: repo (or pull_requests:read + pull_requests:write + contents:write)
# Generate at: https://github.com/settings/tokens
# Without this token, PRISM shows review state but cannot approve or merge.
GITHUB_TOKEN=

# Coverity integration (adapter interface — provide API endpoint and token)
COVERITY_API_URL=
COVERITY_API_TOKEN=

# Black Duck integration (adapter interface — provide URL and API token)
BLACKDUCK_URL=
BLACKDUCK_API_TOKEN=

# ── Background Worker ──
WORKER_CONCURRENCY=2
JOB_TIMEOUT_SECONDS=600

# ── Auto-sync (polling) ──
# How often in seconds PRISM checks each connected repo for new commits.
# Disable with SYNC_INTERVAL_SECONDS=0 if you rely only on GitHub webhooks.
SYNC_INTERVAL_SECONDS=300
SYNC_BATCH_SIZE=10

# ── Rate Limiting ──
RATE_LIMIT_PER_MINUTE=60

# ── Logging ──
LOG_LEVEL=INFO
